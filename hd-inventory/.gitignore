# ===========================
# HD-Inventory — .gitignore
# ===========================

# Python / Django
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# Virtual Environments
Include/
Lib/
Scripts/
pyvenv.cfg
.venv/
venv/
env/

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
backend/staticfiles/
backend/media/
backend/core_main_hdinventory/migrations/
backend/apps/*/migrations/

# Media uploads — ignorar archivos pero conservar la carpeta
media/*
!media/.gitkeep

# Environment variables
.env
.env.local
.env.*.local

# Node / React
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Docker
.docker/

# OS
.DS_Store
Thumbs.db
*.swp
*~

# IDE
.vscode/settings.json
.idea/
*.iml
