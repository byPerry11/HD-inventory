# ===========================
# HD-Inventory — .gitignore
# ===========================

# Python / Django
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# Virtual Environments
Include/
Lib/
Scripts/
pyvenv.cfg
.venv/
venv/
env/

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
backend/staticfiles/
backend/media/
# NOTA: las migrations SÍ se versionan (necesarias para DB consistentes).

# Media uploads — ignorar archivos pero conservar la carpeta
media/*
!media/.gitkeep

# Environment variables
.env
.env.local
.env.*.local

# Node / React
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db
*.swp
*~
*.bak

# IDE
.vscode/settings.json
.idea/
*.iml

# Backups / archivos externos
respaldo de inventario para cargar/
../respaldo de inventario para cargar/
*.xlsm
*.xlsx
!frontend/src/**/*.xlsx

# Documentos y agentes locales (no versionar)
*.docx
.agent/
.hd-inventory-agent/
